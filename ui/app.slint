import { ScrollView, Spinner, ComboBox } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import {
    CardData, TrackData, ShelfData, HeaderData, NowData, MenuEntry, SettingsData, Bridge, Toggle, Segmented, Field,
    Icon, IconButton, PillButton, Seekbar, TrackRow, LinkText, ShelfList, ClampText, Shape,
} from "components.slint";

export { Bridge, Theme, Icons, CardData, TrackData, ShelfData, HeaderData, NowData, MenuEntry, SettingsData }

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    in property <bool> wide;
    callback clicked;
    height: wide ? 48px : 64px;
    Shape {
        radius: 8px;
        fill-color: root.selected ? Theme.raised : (ta.has-hover ? #ffffff0d : transparent);
    }

    if root.wide: HorizontalLayout {
        padding-left: 16px;
        spacing: 22px;
        VerticalLayout {
            alignment: center;
            Icon {
                path: root.icon;
            }
        }
        Text {
            text: root.label;
            font-size: 16px;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    if !root.wide: VerticalLayout {
        alignment: center;
        spacing: 4px;
        HorizontalLayout {
            alignment: center;
            Icon {
                path: root.icon;
            }
        }
        Text {
            text: root.label;
            font-size: 10px;
            color: Theme.text;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger;
    callback clicked;
    height: 44px;
    Shape {
        radius: 6px;
        fill-color: rta.has-hover ? Theme.hover : transparent;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                path: root.icon;
                size: 22px;
                tint: root.danger ? #ff6b6b : Theme.text2;
            }
        }
        Text {
            text: root.label;
            color: root.danger ? #ff6b6b : Theme.text;
            font-size: 15px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    rta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 24px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 500;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text2;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        @children
    }
}

component SettingSection inherits VerticalLayout {
    in property <string> title;
    padding-top: 20px;
    spacing: 0;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
    }

    Rectangle {
        height: 8px;
    }

    @children
}

component SettingsView inherits Rectangle {
    in property <SettingsData> settings;
    in property <[string]> regions;
    in property <bool> signed-in;
    background: Theme.bg;
    TouchArea { }

    ScrollView {
        VerticalLayout {
            padding-left: 48px;
            padding-right: 48px;
            padding-top: 16px;
            padding-bottom: 48px;
            alignment: start;
            Text {
                text: "Settings";
                color: Theme.text;
                font-size: 34px;
                font-weight: 700;
            }

            SettingSection {
                title: "Playback";
                SettingRow {
                    title: "Audio quality";
                    detail: "Best picks Opus, or 256 kbps with YouTube Music Premium. Standard always uses 128 kbps AAC.";
                    HorizontalLayout {
                        alignment: end;
                        Segmented {
                            labels: ["Best", "Standard"];
                            values: ["best", "standard"];
                            value: root.settings.quality;
                            picked(v) => {
                                Bridge.setting("quality", v);
                            }
                        }
                    }
                }

                SettingRow {
                    title: "Autoplay";
                    detail: "Keep playing similar songs when your queue ends.";
                    Toggle {
                        checked: root.settings.autoplay;
                        toggled(on) => {
                            Bridge.setting("autoplay", on ? "1" : "0");
                        }
                    }
                }

                SettingRow {
                    title: "Prepare the next song";
                    detail: "Downloads the next song in advance so skipping is instant.";
                    Toggle {
                        checked: root.settings.prefetch;
                        toggled(on) => {
                            Bridge.setting("prefetch", on ? "1" : "0");
                        }
                    }
                }
            }

            SettingSection {
                title: "Lyrics";
                SettingRow {
                    title: "Synced lyrics from LRCLIB";
                    detail: "Looks up time-synced lyrics on lrclib.net, which receives the song's title and artist. When off, only YouTube Music's own lyrics are shown.";
                    Toggle {
                        checked: root.settings.lrclib;
                        toggled(on) => {
                            Bridge.setting("lrclib", on ? "1" : "0");
                        }
                    }
                }

                SettingRow {
                    title: "Text size";
                    HorizontalLayout {
                        alignment: end;
                        Segmented {
                            labels: ["Small", "Medium", "Large"];
                            values: ["16", "20", "26"];
                            value: root.settings.lyrics-size;
                            picked(v) => {
                                Bridge.setting("lyrics-size", v);
                            }
                        }
                    }
                }
            }

            SettingSection {
                title: "Appearance";
                SettingRow {
                    title: "Accent color";
                    detail: "Used for the progress bar and switches.";
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        for c in ["#ff0000", "#ff4f8b", "#a259ff", "#3ea6ff", "#2bd576", "#ff9a1f"]: Rectangle {
                            width: 30px;
                            height: 30px;
                            Shape {
                                radius: 15px;
                                fill-color: c == "#ff0000" ? #ff0000 : c == "#ff4f8b" ? #ff4f8b : c == "#a259ff" ? #a259ff : c == "#3ea6ff" ? #3ea6ff : c == "#2bd576" ? #2bd576 : #ff9a1f;
                                stroke-color: root.settings.accent == c ? #ffffff : transparent;
                                stroke-w: 2px;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Bridge.setting("accent", c);
                                }
                            }
                        }
                    }
                }
            }

            SettingSection {
                title: "Region";
                SettingRow {
                    title: "Content region";
                    detail: "Home, Explore and charts follow this region.";
                    ComboBox {
                        width: 200px;
                        model: root.regions;
                        current-value: root.settings.region;
                        selected(v) => {
                            Bridge.setting("region", v);
                        }
                    }
                }
            }

            SettingSection {
                title: "Windows";
                SettingRow {
                    title: "Close button keeps Yusic in the tray";
                    detail: "When off, closing the window quits Yusic.";
                    Toggle {
                        checked: root.settings.close-to-tray;
                        toggled(on) => {
                            Bridge.setting("close-to-tray", on ? "1" : "0");
                        }
                    }
                }

                SettingRow {
                    title: "Start with Windows";
                    Toggle {
                        checked: root.settings.start-with-windows;
                        toggled(on) => {
                            Bridge.setting("start-with-windows", on ? "1" : "0");
                        }
                    }
                }

                SettingRow {
                    title: "Start minimized to the tray";
                    detail: "When Yusic starts with Windows.";
                    Toggle {
                        checked: root.settings.start-minimized;
                        toggled(on) => {
                            Bridge.setting("start-minimized", on ? "1" : "0");
                        }
                    }
                }

                SettingRow {
                    title: "Game mode";
                    detail: "Stops redrawing the window while a fullscreen game covers it. On another monitor, Yusic keeps updating.";
                    Toggle {
                        checked: root.settings.game-mode;
                        toggled(on) => {
                            Bridge.setting("game-mode", on ? "1" : "0");
                        }
                    }
                }
            }

            SettingSection {
                title: "Updates";
                SettingRow {
                    title: "Update Yusic automatically";
                    detail: root.settings.installed ? "Installs new releases from GitHub in the background." : "This copy is a development build; it isn't updated from GitHub.";
                    Toggle {
                        checked: root.settings.auto-update;
                        toggled(on) => {
                            Bridge.setting("auto-update", on ? "1" : "0");
                        }
                    }
                }

                SettingRow {
                    title: "Yusic " + root.settings.version;
                    PillButton {
                        text: "Check for updates";
                        clicked => {
                            Bridge.check-updates();
                        }
                    }
                }

                SettingRow {
                    title: "yt-dlp";
                    detail: "Fetches the audio. It updates itself daily.";
                    PillButton {
                        text: "Update now";
                        clicked => {
                            Bridge.update-ytdlp();
                        }
                    }
                }
            }

            SettingSection {
                title: "Account";
                SettingRow {
                    title: root.signed-in ? "Signed in to YouTube Music" : "Not signed in";
                    detail: "Your sign-in is stored encrypted on this PC.";
                    PillButton {
                        text: root.signed-in ? "Sign out" : "Sign in";
                        clicked => {
                            if root.signed-in {
                                Bridge.sign-out();
                            } else {
                                Bridge.sign-in();
                            }
                        }
                    }
                }
            }

            SettingSection {
                title: "About";
                SettingRow {
                    title: "Yusic";
                    detail: "A lightweight YouTube Music client for Windows.";
                    PillButton {
                        text: "GitHub";
                        clicked => {
                            Bridge.open-url("https://github.com/Riqqqque/Yusic");
                        }
                    }
                }
            }
        }
    }
}

component SideItem inherits Rectangle {
    in property <CardData> data;
    height: 52px;
    Shape {
        radius: 8px;
        fill-color: ta.has-hover ? #ffffff0d : transparent;
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 12px;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.data.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: 500;
            overflow: elide;
        }

        Text {
            text: root.data.subtitle;
            color: Theme.text2;
            font-size: 12px;
            overflow: elide;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bridge.navigate("playlist", root.data.id);
        }
    }
}

component Logo inherits HorizontalLayout {
    Text {
        text: "Yusic";
        color: Theme.text;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: -0.5px;
        vertical-alignment: center;
    }
}

component CollectionHeader inherits VerticalLayout {
    in property <HeaderData> header;
    spacing: 12px;
    alignment: start;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 264px;
            height: 264px;
            border-radius: root.header.round ? 132px : 8px;
            clip: true;
            background: Theme.placeholder;
            Image {
                source: root.header.image;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
        }
    }

    Rectangle {
        height: 8px;
    }

    Text {
        text: root.header.title;
        color: Theme.text;
        font-size: 30px;
        font-weight: 700;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    Text {
        text: root.header.line1;
        color: Theme.text2;
        font-size: 15px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    Text {
        text: root.header.line2;
        color: Theme.text2;
        font-size: 14px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }

    if root.header.description != "": ClampText {
        text: root.header.description;
        tint: Theme.text2;
        lines: 3;
        align: center;
    }
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        padding-top: 8px;
        IconButton {
            icon: Icons.shuffle;
            size: 44px;
            bordered: true;
            clicked => {
                Bridge.shuffle-header();
            }
        }

        Rectangle {
            width: 64px;
            height: 64px;
            Shape {
                radius: 32px;
                fill-color: pta.has-hover ? #e0e0e0 : #ffffff;
            }

            Icon {
                path: Icons.play;
                size: 40px;
                tint: #030303;
            }

            pta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Bridge.play-header();
                }
            }
        }

        IconButton {
            icon: Icons.radio;
            size: 44px;
            bordered: true;
            clicked => {
                Bridge.radio-header();
            }
        }

        if root.header.saveable: IconButton {
            icon: root.header.saved ? Icons.library-saved : Icons.library-add;
            size: 44px;
            bordered: true;
            clicked => {
                Bridge.toggle-saved();
            }
        }
        if root.header.owned: IconButton {
            icon: Icons.edit;
            size: 44px;
            bordered: true;
            clicked => {
                Bridge.edit-playlist();
            }
        }
        if root.header.owned: IconButton {
            icon: Icons.delete;
            size: 44px;
            bordered: true;
            clicked => {
                Bridge.delete-playlist();
            }
        }
    }
}

component ArtistHeader inherits Rectangle {
    in property <HeaderData> header;
    height: 420px;
    clip: true;
    Image {
        source: root.header.image;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        background: @linear-gradient(180deg, #03030333 0%, #03030366 45%, #030303 100%);
    }

    VerticalLayout {
        padding-left: 48px;
        padding-right: 48px;
        padding-bottom: 32px;
        spacing: 16px;
        alignment: end;
        Text {
            text: root.header.title;
            color: Theme.text;
            font-size: 52px;
            font-weight: 800;
            overflow: elide;
        }

        if root.header.description != "": ClampText {
            text: root.header.description;
            tint: Theme.text2;
            lines: 3;
            max-width: 760px;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            PillButton {
                icon: Icons.shuffle;
                text: "Shuffle";
                primary: true;
                clicked => {
                    Bridge.shuffle-header();
                }
            }

            PillButton {
                icon: Icons.radio;
                text: "Radio";
                clicked => {
                    Bridge.radio-header();
                }
            }

            if root.header.subscribable: PillButton {
                text: root.header.subscribed ? "Subscribed" : "Subscribe";
                clicked => {
                    Bridge.toggle-subscribed();
                }
            }
        }
    }
}

component NpTab inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    Text {
        text: root.label;
        color: root.selected ? Theme.text : Theme.text3;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.selected: Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.text;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LyricsView inherits Rectangle {
    in property <length> font-size: 20px;
    in property <[string]> lines;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> source;
    property <length> target;
    fl := Flickable {
        content-height: col.preferred-height;
        animate content-y {
            duration: 350ms;
            easing: ease-out;
        }
        col := VerticalLayout {
            width: fl.width;
            padding-top: 16px;
            padding-bottom: root.synced ? 320px : 24px;
            padding-right: 16px;
            spacing: 14px;
            alignment: start;
            for line[i] in root.lines: Rectangle {
                property <bool> is-active: root.synced && i == root.active;
                height: t.preferred-height;
                t := Text {
                    width: parent.width;
                    text: line == "" ? "\u{266A}" : line;
                    wrap: word-wrap;
                    font-size: root.font-size;
                    font-weight: 700;
                    color: !root.synced ? Theme.text : self.is-active-line ? Theme.text : (i < root.active ? Theme.text3 : Theme.text2);
                    property <bool> is-active-line: parent.is-active;
                }

                changed is-active => {
                    if self.is-active {
                        root.target = self.y;
                    }
                }
                if root.synced: TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Bridge.lyric-clicked(i);
                    }
                }
            }
            if root.source != "": Text {
                text: root.source;
                color: Theme.text3;
                font-size: 12px;
            }
        }
    }

    // Keep the current line a third of the way down the panel.
    changed target => {
        fl.content-y = -max(0px, min(root.target - fl.height * 0.33, col.preferred-height - fl.height));
    }
}

component NowPlayingView inherits Rectangle {
    in property <NowData> now;
    in property <[TrackData]> queue;
    in-out property <int> tab;
    in property <[string]> lyrics-lines;
    in property <int> lyrics-active;
    in property <bool> lyrics-synced;
    in property <string> lyrics-state;
    in property <string> lyrics-source;
    in property <int> lyrics-size: 20;
    background: Theme.bg;
    TouchArea { }

    HorizontalLayout {
        padding: 48px;
        padding-top: 24px;
        spacing: 48px;
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                width: min(parent.width, parent.height);
                height: self.width;
                border-radius: 8px;
                clip: true;
                background: Theme.placeholder;
                Image {
                    source: root.now.art;
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
            }
        }

        VerticalLayout {
            width: 460px;
            spacing: 0;
            HorizontalLayout {
                height: 48px;
                NpTab {
                    label: "UP NEXT";
                    selected: root.tab == 0;
                    clicked => {
                        root.tab = 0;
                    }
                }

                NpTab {
                    label: "LYRICS";
                    selected: root.tab == 1;
                    clicked => {
                        root.tab = 1;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            Rectangle {
                height: 8px;
            }

            if root.tab == 0: ScrollView {
                VerticalLayout {
                    alignment: start;
                    for t[i] in root.queue: TrackRow {
                        data: t;
                        clicked => {
                            Bridge.queue-clicked(i);
                        }
                        menu(x, y) => {
                            Bridge.queue-menu(i, x, y);
                        }
                    }
                }
            }
            if root.tab == 1 && root.lyrics-state == "ready": LyricsView {
                font-size: root.lyrics-size * 1px;
                lines: root.lyrics-lines;
                active: root.lyrics-active;
                synced: root.lyrics-synced;
                source: root.lyrics-source;
            }
            if root.tab == 1 && root.lyrics-state == "loading": HorizontalLayout {
                alignment: center;
                padding-top: 48px;
                VerticalLayout {
                    alignment: start;
                    Spinner {
                        indeterminate: true;
                        width: 36px;
                        height: 36px;
                    }
                }
            }
            if root.tab == 1 && (root.lyrics-state == "none" || root.lyrics-state == "error" || root.lyrics-state == ""): VerticalLayout {
                alignment: start;
                padding-top: 48px;
                Text {
                    text: root.lyrics-state == "error" ? "Couldn't load lyrics. Check your connection and try again." : root.lyrics-state == "" ? "Nothing is playing." : "Lyrics aren't available for this song.";
                    color: Theme.text2;
                    font-size: 15px;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

component PlayerBar inherits Rectangle {
    in property <NowData> now;
    in property <bool> playing;
    in property <bool> buffering;
    in property <float> progress;
    in property <string> time-text;
    in property <float> volume;
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in-out property <bool> np-open;
    // Narrow windows: tighter side groups so the song title keeps some room.
    in property <bool> compact;
    background: Theme.surface;
    height: Theme.playerbar;
    TouchArea {
        clicked => {
            root.np-open = !root.np-open;
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 16px;
        spacing: 8px;
        HorizontalLayout {
            width: root.compact ? 236px : 280px;
            alignment: start;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.prev;
                    clicked => {
                        Bridge.prev();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                if root.buffering: Rectangle {
                    width: 48px;
                    height: 48px;
                    Spinner {
                        indeterminate: true;
                        width: 30px;
                        height: 30px;
                    }
                }
                if !root.buffering: IconButton {
                    icon: root.playing ? Icons.pause : Icons.play;
                    size: 48px;
                    icon-size: 38px;
                    clicked => {
                        Bridge.toggle-play();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.next;
                    clicked => {
                        Bridge.next();
                    }
                }
            }

            Text {
                text: root.time-text;
                color: Theme.text2;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: root.compact ? 8px : 16px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 2px;
                    clip: true;
                    background: Theme.placeholder;
                    Image {
                        source: root.now.image;
                        width: parent.width;
                        height: parent.height;
                        image-fit: cover;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                max-width: 520px;
                spacing: 2px;
                Text {
                    text: root.now.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 0;
                    LinkText {
                        text: root.now.artists;
                        font-size: 14px;
                        overflow: elide;
                        link: root.now.artist-id != "";
                        clicked => {
                            Bridge.artist-clicked(root.now.artist-id);
                        }
                    }

                    if root.now.album != "" && !root.compact: Text {
                        text: " • ";
                        color: Theme.text2;
                        font-size: 14px;
                    }
                    if root.now.album != "" && !root.compact: LinkText {
                        text: root.now.album;
                        font-size: 14px;
                        overflow: elide;
                        link: root.now.album-id != "";
                        clicked => {
                            Bridge.album-clicked(root.now.album-id);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 2px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: root.now.rating == 2 ? Icons.thumb-down-filled : Icons.thumb-down;
                        icon-size: 22px;
                        tint: root.now.rating == 2 ? Theme.text : Theme.text2;
                        clicked => {
                            Bridge.rate(root.now.rating == 2 ? 0 : 2);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: root.now.rating == 1 ? Icons.thumb-up-filled : Icons.thumb-up;
                        icon-size: 22px;
                        tint: root.now.rating == 1 ? Theme.text : Theme.text2;
                        clicked => {
                            Bridge.rate(root.now.rating == 1 ? 0 : 1);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    more-btn := IconButton {
                        icon: Icons.more;
                        icon-size: 22px;
                        tint: Theme.text2;
                        clicked => {
                            Bridge.now-menu(self.absolute-position.x, self.absolute-position.y);
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            width: root.compact ? 244px : 280px;
            alignment: end;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.volume <= 0.001 ? Icons.volume-off : Icons.volume;
                    tint: Theme.text2;
                    clicked => {
                        Bridge.toggle-mute();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                Seekbar {
                    width: root.compact ? 64px : 88px;
                    value: root.volume;
                    fill: Theme.text;
                    always-knob: true;
                    live: true;
                    seek(v) => {
                        Bridge.set-volume(v);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.repeat-mode == 2 ? Icons.repeat-one : Icons.repeat;
                    tint: root.repeat-mode == 0 ? Theme.text3 : Theme.text;
                    clicked => {
                        Bridge.cycle-repeat();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.shuffle;
                    tint: root.shuffle ? Theme.text : Theme.text3;
                    clicked => {
                        Bridge.toggle-shuffle();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.np-open ? Icons.drop-down : Icons.drop-up;
                    clicked => {
                        root.np-open = !root.np-open;
                    }
                }
            }
        }
    }

    Seekbar {
        x: 0;
        y: -8px;
        width: parent.width;
        value: root.progress;
        seek(v) => {
            Bridge.seek(v);
        }
    }
}

export component AppWindow inherits Window {
    in property <image> app-icon;
    title: "Yusic";
    icon: app-icon;
    background: Theme.bg;
    default-font-family: Theme.font;
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 840px;
    min-height: 480px;

    // navigation / page
    in-out property <string> section: "home";
    in property <HeaderData> header;
    in property <[ShelfData]> shelves;
    in property <bool> loading;
    in property <string> error;
    in property <string> notice;
    in property <bool> can-back;
    in-out property <length> scroll-y;
    in-out property <bool> sidebar-wide: true;

    // search
    in-out property <string> search-text;
    in property <[string]> suggestions;
    in-out property <bool> search-open;

    // player
    in property <bool> has-track;
    in property <NowData> now;
    in property <bool> playing;
    in property <bool> buffering;
    in property <float> progress;
    in property <string> time-text;
    in property <float> volume: 1.0;
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in property <[TrackData]> queue;
    in-out property <bool> np-open;

    // account
    in property <bool> signed-in;
    in property <[CardData]> side-playlists;
    // Playlists songs can be saved to (no Liked music).
    in property <[CardData]> pick-playlists;
    in property <bool> pick-loading;
    in-out property <bool> account-open;
    in property <string> toast;

    // a newer version is on disk
    in property <bool> update-ready;

    // Flipped to force one full repaint (see win::full_repaint).
    in property <bool> repaint-flip;

    // context menu
    in property <[MenuEntry]> menu-items;
    in-out property <bool> menu-open;
    in property <length> menu-x;
    in property <length> menu-y;

    // dialogs: "" | "playlist" | "pick-playlist" | "confirm"
    in-out property <string> dialog;
    in property <string> dialog-heading;
    in property <string> dialog-message;
    in property <string> dialog-ok;
    in-out property <string> dialog-name;
    in-out property <string> dialog-desc;
    in-out property <string> dialog-privacy: "private";

    // settings page
    in-out property <SettingsData> settings;
    in property <[string]> regions;

    // lyrics (Now Playing panel, tab 1)
    in-out property <int> np-tab: 0;
    in property <[string]> lyrics-lines;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-state;
    in property <string> lyrics-source;

    changed np-open => {
        Bridge.np-changed();
    }
    changed np-tab => {
        Bridge.np-changed();
    }

    // Below 1000px the sidebar collapses (like YouTube Music); the menu
    // button then opens it just for the moment.
    in-out property <bool> narrow-open: false;
    property <bool> narrow: false;
    changed width => {
        root.narrow = root.width < 1000px;
    }
    property <bool> side-open: root.narrow ? root.narrow-open : root.sidebar-wide;
    property <length> side-w: side-open ? Theme.sidebar-wide : Theme.sidebar-narrow;

    // Nearly invisible full-window layer. Changing it marks the whole window
    // as changed, so the partial renderer repaints everything once.
    Rectangle {
        background: root.repaint-flip ? #00000001 : #00000002;
    }

    VerticalLayout {
        // top bar
        HorizontalLayout {
            height: Theme.topbar;
            padding-left: 16px;
            padding-right: 24px;
            spacing: 16px;
            HorizontalLayout {
                width: root.side-w - 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.menu;
                        clicked => {
                            if !root.narrow {
                                root.sidebar-wide = !root.sidebar-wide;
                            } else {
                                root.narrow-open = !root.narrow-open;
                            }
                        }
                    }
                }

                if root.side-open: Logo { }
            }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.back;
                    enabled: root.can-back;
                    clicked => {
                        Bridge.back();
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                min-width: 160px;
                max-width: 480px;
                search-box := Rectangle {
                    height: 40px;
                    Shape {
                        radius: 8px;
                        fill-color: input.has-focus ? #ffffff26 : #ffffff1a;
                        stroke-color: input.has-focus ? #ffffff40 : #ffffff14;
                        stroke-w: 1px;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 4px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                path: Icons.search;
                                tint: Theme.text2;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            input := TextInput {
                                text <=> root.search-text;
                                color: Theme.text;
                                font-size: 16px;
                                vertical-alignment: center;
                                single-line: true;
                                selection-background-color: #3ea6ff66;
                                edited => {
                                    root.search-open = true;
                                    Bridge.search-edited(self.text);
                                }
                                accepted => {
                                    root.search-open = false;
                                    Bridge.search(self.text);
                                    self.clear-focus();
                                }
                            }

                            if root.search-text == "": Text {
                                x: 0;
                                width: parent.width;
                                text: "Search songs, albums, artists, podcasts";
                                color: Theme.text3;
                                font-size: 16px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        if root.search-text != "": VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.close;
                                size: 32px;
                                icon-size: 20px;
                                clicked => {
                                    root.search-text = "";
                                    root.search-open = false;
                                    input.focus();
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 0.6;
            }

            VerticalLayout {
                alignment: center;
                account-btn := IconButton {
                    icon: Icons.account;
                    tint: root.signed-in ? Theme.text : Theme.text2;
                    clicked => {
                        Bridge.account();
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // sidebar
            VerticalLayout {
                width: root.side-w;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                NavItem {
                    icon: Icons.home;
                    label: "Home";
                    wide: root.side-open;
                    selected: root.section == "home";
                    clicked => {
                        Bridge.navigate("home", "");
                    }
                }

                NavItem {
                    icon: Icons.explore;
                    label: "Explore";
                    wide: root.side-open;
                    selected: root.section == "explore";
                    clicked => {
                        Bridge.navigate("explore", "");
                    }
                }

                NavItem {
                    icon: Icons.library;
                    label: "Library";
                    wide: root.side-open;
                    selected: root.section == "library";
                    clicked => {
                        Bridge.navigate("library", "");
                    }
                }

                NavItem {
                    icon: Icons.settings;
                    label: "Settings";
                    wide: root.side-open;
                    selected: root.section == "settings";
                    clicked => {
                        Bridge.open-settings();
                    }
                }

                if root.side-open: Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
                if root.side-open && !root.signed-in: VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    Text {
                        text: "Sign in to create & share playlists, get personalized recommendations, and more.";
                        color: Theme.text;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        alignment: start;
                        PillButton {
                            text: "Sign in";
                            clicked => {
                                Bridge.sign-in();
                            }
                        }
                    }
                }
                if root.side-open && root.signed-in: HorizontalLayout {
                    padding-left: 12px;
                    padding-top: 12px;
                    alignment: start;
                    PillButton {
                        icon: Icons.add;
                        text: "New playlist";
                        clicked => {
                            Bridge.new-playlist();
                        }
                    }
                }
                if root.side-open && root.signed-in: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 8px;
                        for p in root.side-playlists: SideItem {
                            data: p;
                        }
                    }
                }
                if !root.side-open || !root.signed-in: Rectangle {
                    vertical-stretch: 1;
                }
            }

            // page
            Rectangle {
                horizontal-stretch: 1;
                sv := ScrollView {
                    content-y <=> root.scroll-y;
                    content-width: self.visible-width;
                    content-height: content.preferred-height;
                    content := VerticalLayout {
                        width: sv.visible-width;
                        alignment: start;
                        padding-bottom: 48px;
                        if root.header.kind == "artist": ArtistHeader {
                            header: root.header;
                        }
                        if root.header.kind == "collection": HorizontalLayout {
                            padding-left: 32px;
                            padding-right: 40px;
                            padding-top: 24px;
                            spacing: 40px;
                            CollectionHeader {
                                width: min(400px, sv.visible-width * 0.36);
                                header: root.header;
                            }

                            VerticalLayout {
                                alignment: start;
                                horizontal-stretch: 1;
                                ShelfList {
                                    shelves: root.shelves;
                                }
                            }
                        }
                        if root.header.kind != "collection": VerticalLayout {
                            padding-left: 40px;
                            padding-right: 40px;
                            padding-top: 16px;
                            spacing: 16px;
                            alignment: start;
                            if root.header.kind == "title": Text {
                                text: root.header.title;
                                color: Theme.text;
                                font-size: 34px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            ShelfList {
                                shelves: root.shelves;
                            }
                        }
                        if root.notice != "": VerticalLayout {
                            padding: 64px;
                            spacing: 20px;
                            Text {
                                text: root.notice;
                                color: Theme.text2;
                                font-size: 16px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            if root.section == "library" && !root.signed-in: HorizontalLayout {
                                alignment: center;
                                PillButton {
                                    text: "Sign in";
                                    primary: true;
                                    clicked => {
                                        Bridge.sign-in();
                                    }
                                }
                            }
                        }
                        if root.error != "": VerticalLayout {
                            padding: 64px;
                            spacing: 16px;
                            alignment: center;
                            Text {
                                text: root.error;
                                color: Theme.text2;
                                font-size: 16px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                alignment: center;
                                PillButton {
                                    text: "Retry";
                                    clicked => {
                                        Bridge.retry();
                                    }
                                }
                            }
                        }
                        if root.loading: HorizontalLayout {
                            padding: 48px;
                            alignment: center;
                            Spinner {
                                indeterminate: true;
                                width: 40px;
                                height: 40px;
                            }
                        }
                    }

                    changed content-y => {
                        if !root.loading && (-self.content-y + self.visible-height > self.content-height - 900px) {
                            Bridge.load-more();
                        }
                    }
                    // Pages shorter than the window never scroll; fetch more right away.
                    changed content-height => {
                        if !root.loading && self.content-height < self.visible-height + 900px {
                            Bridge.load-more();
                        }
                    }
                }

                if root.section == "settings": SettingsView {
                    settings: root.settings;
                    regions: root.regions;
                    signed-in: root.signed-in;
                }
                if root.np-open: NowPlayingView {
                    now: root.now;
                    queue: root.queue;
                    tab <=> root.np-tab;
                    lyrics-lines: root.lyrics-lines;
                    lyrics-active: root.lyrics-active;
                    lyrics-synced: root.lyrics-synced;
                    lyrics-state: root.lyrics-state;
                    lyrics-source: root.lyrics-source;
                    lyrics-size: root.settings.lyrics-size;
                }
            }
        }

        if root.has-track: PlayerBar {
            compact: root.narrow;
            now: root.now;
            playing: root.playing;
            buffering: root.buffering;
            progress: root.progress;
            time-text: root.time-text;
            volume: root.volume;
            shuffle: root.shuffle;
            repeat-mode: root.repeat-mode;
            np-open <=> root.np-open;
        }
    }

    // account menu
    if root.account-open: TouchArea {
        clicked => {
            root.account-open = false;
        }
    }
    if root.account-open: Rectangle {
        x: account-btn.absolute-position.x + account-btn.width - self.width;
        y: account-btn.absolute-position.y + account-btn.height + 6px;
        width: 220px;
        height: menu.preferred-height;
        Shape {
            radius: 10px;
            fill-color: #282828;
            stroke-color: #ffffff1a;
            stroke-w: 1px;
        }

        menu := VerticalLayout {
            padding: 8px;
            MenuRow {
                icon: Icons.settings;
                label: "Settings";
                clicked => {
                    root.account-open = false;
                    Bridge.open-settings();
                }
            }

            MenuRow {
                icon: Icons.account;
                label: "Sign out";
                clicked => {
                    root.account-open = false;
                    Bridge.sign-out();
                }
            }
        }
    }

    // context menu
    if root.menu-open: TouchArea {
        clicked => {
            root.menu-open = false;
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu-open = false;
            }
        }
    }
    if root.menu-open: Rectangle {
        x: max(8px, min(root.menu-x, root.width - self.width - 8px));
        y: root.menu-y + self.height > root.height - 8px ? max(8px, root.menu-y - self.height) : root.menu-y;
        width: 264px;
        height: ctx.preferred-height;
        Shape {
            radius: 10px;
            fill-color: #282828;
            stroke-color: #ffffff1a;
            stroke-w: 1px;
        }

        ctx := VerticalLayout {
            padding: 8px;
            for m in root.menu-items: MenuRow {
                icon: m.icon;
                label: m.label;
                danger: m.danger;
                clicked => {
                    root.menu-open = false;
                    Bridge.menu-action(m.id);
                }
            }
        }
    }

    // dialogs
    if root.dialog != "": Rectangle {
        background: #000000a6;
        TouchArea {
            clicked => {
                Bridge.dialog-cancel();
            }
        }
    }
    if root.dialog != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: max(24px, (root.height - self.height) / 2);
        width: min(480px, root.width - 48px);
        height: dlg.preferred-height;
        Shape {
            radius: 14px;
            fill-color: #212121;
            stroke-color: #ffffff1a;
            stroke-w: 1px;
        }

        // Clicks inside the dialog must not reach the backdrop (which cancels).
        TouchArea { }

        dlg := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: root.dialog-heading;
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }

            if root.dialog == "confirm": Text {
                text: root.dialog-message;
                color: Theme.text2;
                font-size: 15px;
                wrap: word-wrap;
            }
            if root.dialog == "playlist": Field {
                text <=> root.dialog-name;
                placeholder: "Title";
                accepted => {
                    Bridge.dialog-submit();
                }
            }
            if root.dialog == "playlist": Field {
                text <=> root.dialog-desc;
                placeholder: "Description (optional)";
            }
            if root.dialog == "playlist": VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Privacy";
                    color: Theme.text2;
                    font-size: 13px;
                }

                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        labels: ["Private", "Unlisted", "Public"];
                        values: ["private", "unlisted", "public"];
                        value: root.dialog-privacy;
                        picked(v) => {
                            root.dialog-privacy = v;
                        }
                    }
                }
            }
            if root.dialog == "pick-playlist": VerticalLayout {
                spacing: 2px;
                MenuRow {
                    icon: Icons.add;
                    label: "New playlist";
                    clicked => {
                        Bridge.new-playlist();
                    }
                }

                Rectangle {
                    // Leaves room for the heading and Cancel in short windows.
                    height: min(360px, max(96px, root.height - 280px), picks.preferred-height);
                    ScrollView {
                        picks := VerticalLayout {
                            alignment: start;
                            if root.pick-loading: HorizontalLayout {
                                alignment: center;
                                padding: 16px;
                                Spinner {
                                    indeterminate: true;
                                    width: 28px;
                                    height: 28px;
                                }
                            }
                            for p in root.pick-playlists: MenuRow {
                                icon: p.subtitle != "" ? Icons.library-saved : Icons.queue-add;
                                label: p.subtitle != "" ? p.title + "  (" + p.subtitle + ")" : p.title;
                                clicked => {
                                    Bridge.choose-playlist(p.id);
                                }
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                PillButton {
                    text: "Cancel";
                    clicked => {
                        Bridge.dialog-cancel();
                    }
                }

                if root.dialog != "pick-playlist": PillButton {
                    text: root.dialog-ok;
                    primary: true;
                    clicked => {
                        Bridge.dialog-submit();
                    }
                }
            }
        }
    }

    // update banner
    if root.update-ready: Rectangle {
        x: root.width - self.width - 24px;
        y: root.height - (root.has-track ? Theme.playerbar : 0px) - self.height - 24px;
        width: banner.preferred-width;
        height: 56px;
        Shape {
            radius: 12px;
            fill-color: #2a2a2a;
            stroke-color: #ffffff1a;
            stroke-w: 1px;
        }

        banner := HorizontalLayout {
            padding-left: 20px;
            padding-right: 10px;
            spacing: 16px;
            Text {
                text: "A new version of Yusic is ready";
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                PillButton {
                    text: "Restart";
                    primary: true;
                    clicked => {
                        Bridge.restart-update();
                    }
                }
            }
        }
    }

    // transient message
    if root.toast != "": Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - (root.has-track ? Theme.playerbar : 0px) - self.height - (root.update-ready ? 96px : 24px);
        width: min(toast-text.preferred-width + 40px, root.width - 80px);
        height: max(44px, toast-text.preferred-height + 20px);
        Shape {
            radius: 8px;
            fill-color: #323232;
        }

        toast-text := Text {
            x: 20px;
            width: parent.width - 40px;
            text: root.toast;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }

    // search suggestions dropdown
    if root.search-open && root.suggestions.length > 0: TouchArea {
        clicked => {
            root.search-open = false;
        }
    }
    if root.search-open && root.suggestions.length > 0: Rectangle {
        x: search-box.absolute-position.x;
        y: search-box.absolute-position.y + search-box.height + 4px;
        width: search-box.width;
        height: list.preferred-height;
        background: #212121;
        border-radius: 8px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #000000a0;
        list := VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            for s in root.suggestions: Rectangle {
                height: 44px;
                background: sta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 16px;
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            path: Icons.search;
                            size: 20px;
                            tint: Theme.text2;
                        }
                    }

                    Text {
                        text: s;
                        color: Theme.text;
                        font-size: 15px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                sta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.search-text = s;
                        root.search-open = false;
                        input.clear-focus();
                        Bridge.search(s);
                    }
                }
            }
        }
    }
}
